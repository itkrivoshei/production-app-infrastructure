#!/usr/bin/env bash
set -Eeuxo pipefail

COMPOSE_VERSION="v5.1.4"
INSTALL_DIR="/opt/devops-control-center"

dnf update -y
dnf install -y docker curl
systemctl enable --now docker

architecture="$(uname -m)"
case "$architecture" in
  x86_64)
    compose_arch="x86_64"
    ;;
  aarch64)
    compose_arch="aarch64"
    ;;
  *)
    echo "Unsupported architecture: $architecture" >&2
    exit 1
    ;;
esac

install -d -m 0755 /usr/local/lib/docker/cli-plugins "$INSTALL_DIR"
curl -fsSLo /tmp/docker-compose \
  "https://github.com/docker/compose/releases/download/$${COMPOSE_VERSION}/docker-compose-linux-$${compose_arch}"
curl -fsSLo /tmp/docker-compose.sha256 \
  "https://github.com/docker/compose/releases/download/$${COMPOSE_VERSION}/docker-compose-linux-$${compose_arch}.sha256"
(
  cd /tmp
  sed -i 's#docker-compose-linux-[^ ]*#docker-compose#' docker-compose.sha256
  sha256sum -c docker-compose.sha256
)
install -m 0755 /tmp/docker-compose /usr/local/lib/docker/cli-plugins/docker-compose

cat >"$INSTALL_DIR/nginx.conf" <<'NGINX'
pid /tmp/nginx.pid;
events {}
http {
  include /etc/nginx/mime.types;
  client_body_temp_path /tmp/client_temp;
  proxy_temp_path /tmp/proxy_temp;
  fastcgi_temp_path /tmp/fastcgi_temp;
  uwsgi_temp_path /tmp/uwsgi_temp;
  scgi_temp_path /tmp/scgi_temp;
  client_max_body_size 64k;
  server_tokens off;

  limit_req_zone $binary_remote_addr zone=api_limit:10m rate=100r/s;

  upstream api_upstream { server api:8080; }
  upstream web_upstream { server web:8080; }

  server {
    listen 8080;
    server_name _;
    access_log /dev/stdout;
    error_log /dev/stderr warn;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:" always;

    location /nginx-health {
      access_log off;
      return 200 "nginx ok\n";
      add_header Content-Type text/plain;
    }

    location /api/docs {
      limit_req zone=api_limit burst=200 nodelay;
      proxy_pass http://api_upstream/docs;
      proxy_http_version 1.1;
      proxy_connect_timeout 5s;
      proxy_read_timeout 15s;
      proxy_send_timeout 15s;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;

      add_header X-Content-Type-Options "nosniff" always;
      add_header X-Frame-Options "DENY" always;
      add_header Referrer-Policy "no-referrer" always;
      add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
      add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:" always;
    }

    location /api/ {
      limit_req zone=api_limit burst=200 nodelay;
      proxy_pass http://api_upstream/;
      proxy_http_version 1.1;
      proxy_connect_timeout 5s;
      proxy_read_timeout 15s;
      proxy_send_timeout 15s;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
      proxy_pass http://web_upstream;
      proxy_http_version 1.1;
      proxy_connect_timeout 5s;
      proxy_read_timeout 15s;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }
  }
}
NGINX

cat >"$INSTALL_DIR/compose.yml" <<'COMPOSE'
x-logging: &default-logging
  driver: "json-file"
  options:
    max-size: "10m"
    max-file: "3"

x-app-security: &app-security
  init: true
  read_only: true
  security_opt:
    - no-new-privileges:true
  cap_drop:
    - ALL
  tmpfs:
    - /tmp

services:
  api:
    image: ${api_image}
    environment:
      APP_ENV: aws-demo
      APP_MODE: safe
      APP_VERSION: ${app_version}
      COMMIT_SHA: ${commit_sha}
      LOG_FORMAT: json
      PORT: 8080
    expose:
      - "8080"
    restart: unless-stopped
    logging: *default-logging
    healthcheck:
      test:
        [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:8080/health').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))",
        ]
      interval: 30s
      timeout: 5s
      retries: 3
    <<: *app-security
    deploy:
      resources:
        limits:
          cpus: "1.00"
          memory: 512M

  web:
    image: ${web_image}
    expose:
      - "8080"
    restart: unless-stopped
    logging: *default-logging
    depends_on:
      api:
        condition: service_healthy
    <<: *app-security
    tmpfs:
      - /tmp
      - /var/cache/nginx
      - /var/run
    deploy:
      resources:
        limits:
          cpus: "0.50"
          memory: 128M
    healthcheck:
      test:
        ["CMD-SHELL", "wget -q --spider http://127.0.0.1:8080/health || exit 1"]
      interval: 30s
      timeout: 5s
      start_period: 10s
      retries: 3

  edge:
    image: ${edge_image}
    ports:
      - "80:8080"
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
    restart: unless-stopped
    logging: *default-logging
    depends_on:
      api:
        condition: service_healthy
      web:
        condition: service_healthy
    <<: *app-security
    tmpfs:
      - /tmp
      - /var/cache/nginx
      - /var/run
    deploy:
      resources:
        limits:
          cpus: "0.50"
          memory: 128M
    healthcheck:
      test:
        [
          "CMD-SHELL",
          "wget -q --spider http://127.0.0.1:8080/nginx-health || exit 1",
        ]
      interval: 30s
      timeout: 5s
      start_period: 10s
      retries: 3
COMPOSE

cd "$INSTALL_DIR"
docker compose -f compose.yml pull
docker compose -f compose.yml up -d --wait --wait-timeout 120

for attempt in $(seq 1 30); do
  if curl -fsS --max-time 5 http://127.0.0.1/ >/dev/null &&
    curl -fsS --max-time 5 http://127.0.0.1/api/health >/dev/null &&
    curl -fsS --max-time 5 http://127.0.0.1/api/ready | grep -Fq '"status":"ready"' &&
    curl -fsS --max-time 5 http://127.0.0.1/api/version | grep -Fq '"version":"${app_version}"' &&
    curl -fsS --max-time 5 http://127.0.0.1/api/version | grep -Fq '"commit":"${commit_sha}"'; then
    exit 0
  fi
  sleep 2
done

docker compose -f compose.yml logs >&2
exit 1
