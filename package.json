{
  "name": "production-app-infrastructure",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "description": "Production-like DevOps Control Center with Docker, GitHub Actions, Terraform, Prometheus, Grafana, Loki, k6, Trivy, and AWS-ready infrastructure.",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:detached": "bash scripts/dev.sh detached",
    "down": "bash scripts/dev.sh down",
    "clean": "bash scripts/clean.sh",
    "clean:force": "bash scripts/clean.sh --force",
    "health": "bash scripts/healthcheck.sh",
    "logs": "bash scripts/logs.sh",
    "restart": "bash scripts/restart.sh",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up",
    "docker:dev": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:ps": "docker compose ps",
    "docker:logs": "docker compose logs -f",
    "docker:health": "bash scripts/healthcheck.sh",
    "api:dev": "pnpm --filter @production-app-infrastructure/api dev",
    "api:build": "pnpm --filter @production-app-infrastructure/api build",
    "api:test": "pnpm --filter @production-app-infrastructure/api test",
    "api:typecheck": "pnpm --filter @production-app-infrastructure/api typecheck",
    "web:dev": "pnpm --filter @production-app-infrastructure/web dev",
    "web:build": "pnpm --filter @production-app-infrastructure/web build",
    "web:test": "pnpm --filter @production-app-infrastructure/web test",
    "web:typecheck": "pnpm --filter @production-app-infrastructure/web typecheck",
    "web:preview": "pnpm --filter @production-app-infrastructure/web preview",
    "dev:local": "concurrently -n api,web -c blue,green \"pnpm api:dev\" \"pnpm web:dev\"",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "keywords": [
    "devops",
    "docker",
    "terraform",
    "aws",
    "github-actions",
    "prometheus",
    "grafana",
    "loki",
    "k6",
    "trivy",
    "typescript",
    "react",
    "fastify",
    "ci-cd",
    "observability"
  ],
  "author": "Nikita Krivoshei",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.0"
  }
}
